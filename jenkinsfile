pipeline{
    agent any
    tools {nodejs "nodejs"}

   environment {
    CYPRESS_CACHE_FOLDER = "C:\\cy_cache"
    CI = 'true'
}

    stages{

        stage("clonar o hub de leitura integrado"){
            steps{
                bat '''
                    if exist hub-de-leitura-integrado2 rmdir /s /q hub-de-leitura-integrado2
                    git clone https://github.com/EBAC-QE/hub-de-leitura-integrado2.git
                '''
            }
        }

        stage("Instalar dependencias do projeto"){
            steps{
               dir('hub-de-leitura-integrado2') {
                bat '''
                    call npm install
                    start /B npm start
                '''
               }
            }
        }

        stage("clonar o projeto de teste"){
            steps{
                bat '''
                if exist hub-de-leitura-teste-ui2 rmdir /s /q hub-de-leitura-teste-ui2
                git clone https://github.com/sennadanii/hub-de-leitura-teste-ui2.git
                '''
            }
        }

        stage("instalar dependencias do projeto de teste"){
            steps {
                dir('hub-de-leitura-teste-ui2') {
                    bat '''
                        call npm install
                        npx cypress install
                        npx cypress verify
                    '''
                }
            }
        }

        stage("executar os testes automatizados"){
            steps {
                dir('hub-de-leitura-teste-ui2'){
                    bat 'call npm test'
                }
            }
        }
    }

    post {
        always{
            dir ('hub-de-leitura-teste-ui2') {
                archiveArtifacts artifacts: 'cypress/screenshots/**/*.*, cypress/videos/**/*.*', allowEmptyArchive: true
            }
            bat 'taskkill /F /IM node.exe /T || exit 0'
        }
    }
}