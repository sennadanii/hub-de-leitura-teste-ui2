pipeline{
    agent any
    tools {nodejs "nodejs"}

    stages{

        stage("clonar o hub de leitura integrado"){
            steps{
                bat 'rm -rf hub-de-leitura-integrado2 ||true'
                bat 'git clone --depth 1 https://github.com/EBAC-QE/hub-de-leitura-integrado2.git' 
            }
        }

        stage("Instalar dependencias do projeto"){
            steps{
               dir('hub-de-leitura-integrado2') {
                bat 'npm install'
                bat 'nohup npm start > app.log 2>&1 &'
               }
            }
        }

        stage("clonar o projeto de teste"){
            steps{
                bat 'rm -rf hub-de-leitura-teste-ui2|| true'
                bat 'git clone --depth 1 https://github.com/sennadanii/hub-de-leitura-teste-ui2.git' 
            }
        }

        stage("instalar dependencias do projeto de teste"){
            steps {
                dir('hub-de-leitura-teste-ui2') {
                    bat 'npm install'
                }
            }
        }

        stage("executar os testes automatizados"){
            steps {
                dir('hub-de-leitura-teste-ui2'){
                    bat 'npm test'
                }
            }
        }
    }

    post {
        always{
            dir ('hub-de-leitura-teste-ui2') {
                archiveArtifacts artifacts: 'cypress/screenshots/**/*.*, cypress/videos/**/*.*',allowEmptyArchive: true
            }
            
            sh 'pkill -f "node" || true'
        }
    }
}